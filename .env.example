# Keyli — Variables d'environnement (Web)
# Copier en .env une fois le nouveau projet Supabase créé.
# NE JAMAIS committer le fichier .env réel — seul ce template l'est.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ Ne JAMAIS mettre ici : service_role key, secret Paystack, API secret
# Cloudinary. Ces clés vivent uniquement dans les secrets des Edge Functions
# (Supabase Dashboard → Edge Functions → Secrets), jamais dans un .env
# consommé par le bundle Vite (tout ce qui commence par VITE_ finit dans le
# code JavaScript livré au navigateur).
