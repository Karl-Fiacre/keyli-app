{
  "expo": {
    "name": "Keyli",
    "slug": "keyli",
    "version": "0.1.0",
    "scheme": "keyli",
    "orientation": "portrait",
    "icon": "./assets/icone.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-blanc.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1f2e"
    },
    "ios": {
      "bundleIdentifier": "com.keyli.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.keyli.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone-adaptative.png",
        "backgroundColor": "#1a1f2e"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Keyli utilise l'appareil photo pour photographier les biens que vous publiez.",
          "photosPermission": "Keyli accède à vos photos pour ajouter des images à vos annonces.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Keyli utilise votre position pour placer votre bien sur la carte quand vous publiez une annonce."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
