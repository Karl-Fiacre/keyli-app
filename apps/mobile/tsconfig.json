{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/integrations/supabase/client": ["./src/integrations/supabase/client"],
      "@/integrations/supabase/types": ["../../src/integrations/supabase/types"],
      "@/plateforme": ["./src/plateforme"],
      "@/partage/*": ["../../src/partage/*"],
      "@mobile/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["index.ts", "App.tsx", "src/**/*", "../../src/partage/**/*"],
  "exclude": ["node_modules", "../../src/partage/**/*.test.ts"]
}
